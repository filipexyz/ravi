# Executor image built from the same source as apps/console/Dockerfile.
# Deploy in its own trust environment. Never mount Console secrets or the Docker socket.
ARG NODE_IMAGE=node@sha256:55fb5f5a527ea2c5c4a95f963e48ef90aa38c7b346054fdc8ee9957a2b55d205
ARG BUN_IMAGE=oven/bun@sha256:93d5032fe06d163427822dc1598f420363759bb18155c9cc90eb1be05a64a19e
FROM ${BUN_IMAGE} AS bun
FROM ${NODE_IMAGE} AS build
COPY --from=bun /usr/local/bin/bun /usr/local/bin/bun
WORKDIR /build
COPY . .
RUN bun install --frozen-lockfile --ignore-scripts && bun run build

FROM ${NODE_IMAGE} AS runtime
COPY --from=bun /usr/local/bin/bun /usr/local/bin/bun
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates bash coreutils git python3 tini && rm -rf /var/lib/apt/lists/*
ENV BUN_INSTALL=/opt/codex
RUN bun add --global @openai/codex@0.163.0
RUN groupadd --gid 11000 ravi && useradd --uid 11000 --gid ravi --create-home ravi && install -d -m 0700 -o ravi -g ravi /var/lib/ravi /workspace
COPY --from=build /build/package.json /opt/ravi-package/package.json
COPY --from=build /build/node_modules /opt/ravi-package/node_modules
COPY --from=build /build/dist /opt/ravi-package/dist
COPY --from=build /build/bin/ravi /opt/ravi-package/bin/ravi
RUN ln -s /opt/ravi-package/bin/ravi /usr/local/bin/ravi
ENV PATH=/opt/codex/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin RAVI_STATE_DIR=/var/lib/ravi RAVI_BIN=/opt/ravi-package/bin/ravi
WORKDIR /workspace
USER 11000:11000
ENTRYPOINT ["/usr/bin/tini","--"]
CMD ["ravi","daemon","run"]
