+import { afterEach, describe, expect, it, vi } from "@effect/vitest";
+import { oidcAuthorizationParams, withOidcNonce } from "./oidc-validation";
+import { fetchAuthConfig } from "../../web/auth-config";
+
+afterEach(() => vi.unstubAllGlobals());
+const secret = "synthetic-signing-secret-32-bytes-minimum";
+describe("OIDC nonce binding", () => {
+  it("issues a host-only signed nonce, validates it on callback, then clears it", async () => {
+    let nonce = "";
+    const start = await withOidcNonce(
+      new Request("https://executor.test/api/auth/sign-in/oauth2", { method: "POST" }),
+      secret,
+      async () => {
+        nonce = oidcAuthorizationParams().nonce!;
+        return Response.json({ status: "start" });
+      },
+    );
+    const cookie = start.headers.get("set-cookie")!;
+    expect(cookie).toContain("__Host-executor_oidc_nonce=");
+    expect(cookie).toContain("Secure; HttpOnly; SameSite=Lax");
+    expect(cookie).not.toContain("Domain=");
+    const callback = await withOidcNonce(
+      new Request("https://executor.test/api/auth/oauth2/callback/customer-sso", {
+        headers: { cookie: cookie.split(";")[0]! },
+      }),
+      secret,
+      async () => {
+        expect(oidcAuthorizationParams().nonce).toBe(nonce);
+        return Response.json({ status: "callback" });
+      },
+    );
+    expect(callback.status).toBe(200);
+    expect(callback.headers.get("set-cookie")).toContain("Max-Age=0");
+  });
+  it("refuses missing, malformed, or differently signed callback nonce before auth", async () => {
+    const run = vi.fn();
+    for (const cookie of ["", "__Host-executor_oidc_nonce=forged"]) {
+      const response = await withOidcNonce(
+        new Request("https://executor.test/api/auth/oauth2/callback/customer-sso", {
+          headers: { cookie },
+        }),
+        secret,
+        run,
+      );
+      expect(response.status).toBe(401);
+    }
+    expect(run).not.toHaveBeenCalled();
+    expect(() => oidcAuthorizationParams()).toThrow();
+  });
+});
+describe("SSO-only pre-login configuration", () => {
+  it("returns only the configured mode/provider metadata", async () => {
+    const config = {
+      passwordEnabled: false,
+      ssoProviders: [{ id: "customer-sso", name: "Organization" }],
+    };
+    vi.stubGlobal("fetch", async () => Response.json(config));
+    expect(await fetchAuthConfig()).toEqual(config);
+  });
+  it("never defaults an unavailable endpoint to local password signup", async () => {
+    for (const response of [
+      Response.json({}, { status: 503 }),
+      Response.json({ ssoProviders: [] }),
+      Response.json({ passwordEnabled: false, ssoProviders: [null] }),
+    ]) {
+      vi.stubGlobal("fetch", async () => response);
+      await expect(fetchAuthConfig()).rejects.toThrow();
+    }
+  });
+});
