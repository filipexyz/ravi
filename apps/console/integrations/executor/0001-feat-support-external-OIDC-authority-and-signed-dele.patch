diff --git a/apps/host-selfhost/src/auth/external-authority.test.ts b/apps/host-selfhost/src/auth/external-authority.test.ts
new file mode 100644
index 0000000..96e98c4
--- /dev/null
+++ b/apps/host-selfhost/src/auth/external-authority.test.ts
@@ -0,0 +1,81 @@
+import { mkdtempSync } from "node:fs";
+import { join } from "node:path";
+import { tmpdir } from "node:os";
+import { afterAll, expect, it, vi } from "@effect/vitest";
+
+// Boot the actual complete application. No IdP stub: authentication roundtrips
+// belong to the real-provider staging test; this exercises pre-auth negatives.
+const base = "https://executor.example.test";
+const issuer = "https://idp.example.test/realms/test";
+for (const [name, value] of Object.entries({
+  EXECUTOR_DATA_DIR: mkdtempSync(join(tmpdir(), "executor-authority-test-")),
+  EXECUTOR_SSO_ONLY: "true",
+  EXECUTOR_WEB_BASE_URL: base,
+  EXECUTOR_SSO_PROVIDER_ID: "customer-sso",
+  EXECUTOR_SSO_PROVIDER_NAME: "Organization",
+  EXECUTOR_SSO_CLIENT_ID: "synthetic-client",
+  EXECUTOR_SSO_CLIENT_SECRET: "synthetic-secret",
+  EXECUTOR_SSO_ALLOWED_DOMAINS: "example.test",
+  EXECUTOR_IDENTITY_ISSUER: issuer,
+  EXECUTOR_SSO_DISCOVERY_URL: `${issuer}/.well-known/openid-configuration`,
+  EXECUTOR_IDENTITY_AUTHORITY_ORIGIN: "https://authority.example.test",
+  EXECUTOR_DELEGATION_ISSUER: "https://authority.example.test",
+  BETTER_AUTH_SECRET: "synthetic-test-auth-secret-at-least-32-characters",
+  EXECUTOR_DISABLE_ANALYTICS: "true",
+}))
+  vi.stubEnv(name, value);
+vi.stubEnv("EXECUTOR_BOOTSTRAP_ADMIN_EMAIL", undefined);
+vi.stubEnv("EXECUTOR_BOOTSTRAP_ADMIN_PASSWORD", undefined);
+const { makeSelfHostApiHandler } = await import("../app");
+const { handler, dispose } = await makeSelfHostApiHandler();
+afterAll(async () => {
+  await dispose();
+  vi.unstubAllEnvs();
+});
+const post = (path: string, body: unknown) =>
+  handler(
+    new Request(`${base}${path}`, {
+      method: "POST",
+      headers: { "content-type": "application/json", origin: base },
+      body: JSON.stringify(body),
+    }),
+  );
+
+it("boots complete app without local bootstrap admin and advertises SSO-only", async () => {
+  expect((await handler(new Request(`${base}/api/health`))).status).toBe(200);
+  expect(await (await handler(new Request(`${base}/api/setup-status`))).json()).toEqual({
+    needsSetup: false,
+  });
+  expect(await (await handler(new Request(`${base}/api/auth-config`))).json()).toEqual({
+    passwordEnabled: false,
+    ssoProviders: [{ id: "customer-sso", name: "Organization" }],
+  });
+});
+it("refuses local signup and password sign-in without granting a session", async () => {
+  for (const path of ["/api/auth/sign-up/email", "/api/auth/sign-in/email"]) {
+    const response = await post(path, {
+      name: "Synthetic",
+      email: "user@example.test",
+      password: "synthetic-password",
+    });
+    expect(response.status).toBeGreaterThanOrEqual(400);
+    expect(response.headers.get("set-cookie") ?? "").not.toContain("session_token=");
+  }
+});
+it("refuses local authority management, account rebinding and unsigned delegation", async () => {
