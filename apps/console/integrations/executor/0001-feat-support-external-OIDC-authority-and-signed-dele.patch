new file mode 100644
index 0000000..5f0d21c
--- /dev/null
+++ b/apps/host-selfhost/src/auth/oidc-validation.ts
@@ -0,0 +1,124 @@
+import { AsyncLocalStorage } from "node:async_hooks";
+import { randomBytes } from "node:crypto";
+import { createRemoteJWKSet, jwtVerify, SignJWT } from "jose";
+import type { SsoConfig } from "../config";
+
+const NONCE_COOKIE = "__Host-executor_oidc_nonce";
+const contexts = new AsyncLocalStorage<{ nonce: string | null }>();
+const keySets = new Map<string, ReturnType<typeof createRemoteJWKSet>>();
+
+export const oidcAuthorizationParams = (): Record<string, string> => {
+  const nonce = contexts.getStore()?.nonce;
+  // oxlint-disable-next-line executor/no-try-catch-or-throw, executor/no-error-constructor -- boundary: Better Auth callback must reject requests outside the nonce context
+  if (!nonce) throw new Error("OIDC request context missing");
+  return { nonce };
+};
+
+/** The native genericOAuth default decodes id_token without verification. This
+ * configured hook validates it before Better Auth creates a user or session. */
+export async function verifiedOidcUserInfo(sso: SsoConfig, idToken: string | undefined) {
+  const nonce = contexts.getStore()?.nonce;
+  const issuer = process.env.EXECUTOR_IDENTITY_ISSUER;
+  if (
+    !nonce ||
+    !issuer ||
+    !idToken ||
+    sso.discoveryUrl !== `${issuer}/.well-known/openid-configuration`
+  )
+    return null;
+  const discoveryResponse = await fetch(sso.discoveryUrl, {
+    redirect: "error",
+    signal: AbortSignal.timeout(5_000),
+  });
+  if (!discoveryResponse.ok) return null;
+  const discovery = (await discoveryResponse.json()) as { issuer?: unknown; jwks_uri?: unknown };
+  if (discovery.issuer !== issuer || typeof discovery.jwks_uri !== "string") return null;
+  const jwksUrl = new URL(discovery.jwks_uri);
+  if (
+    jwksUrl.protocol !== "https:" ||
+    jwksUrl.origin !== new URL(issuer).origin ||
+    jwksUrl.username ||
+    jwksUrl.password
+  )
+    return null;
+  let keys = keySets.get(jwksUrl.href);
+  if (!keys) {
+    keys = createRemoteJWKSet(jwksUrl);
+    keySets.set(jwksUrl.href, keys);
+  }
+  const { payload } = await jwtVerify(idToken, keys, {
+    issuer,
+    audience: sso.clientId,
+    algorithms: ["RS256", "ES256"],
+    requiredClaims: ["sub", "iat", "exp", "nonce"],
+  });
+  if (
+    payload.nonce !== nonce ||
+    payload.email_verified !== true ||
+    typeof payload.email !== "string" ||
+    typeof payload.sub !== "string" ||
+    (Array.isArray(payload.aud) && payload.aud.length > 1 && payload.azp !== sso.clientId) ||
+    (payload.azp !== undefined && payload.azp !== sso.clientId)
+  )
+    return null;
+  return {
+    id: payload.sub,
+    email: payload.email,
+    emailVerified: true,
+    name: typeof payload.name === "string" ? payload.name : payload.email,
+    image: typeof payload.picture === "string" ? payload.picture : undefined,
+  };
+}
+
+export async function withOidcNonce(
+  request: Request,
+  authSecret: string,
+  run: () => Promise<Response>,
+): Promise<Response> {
+  const path = new URL(request.url).pathname;
+  const signingIn = path === "/api/auth/sign-in/oauth2";
+  const callback = path.startsWith("/api/auth/oauth2/callback/");
+  if (!signingIn && !callback) return run();
+  const key = new TextEncoder().encode(authSecret);
+  let nonce: string | null = signingIn ? randomBytes(32).toString("base64url") : null;
+  if (callback) {
+    const cookie = (request.headers.get("cookie") ?? "")
+      .split(";")
+      .map((entry) => entry.trim())
+      .find((entry) => entry.startsWith(`${NONCE_COOKIE}=`))
+      ?.slice(NONCE_COOKIE.length + 1);
+    if (cookie) {
+      // oxlint-disable-next-line executor/no-try-catch-or-throw -- boundary: invalid jose cookie proof must become an HTTP denial, never a nonce
+      try {
+        const { payload } = await jwtVerify(cookie, key, {
+          algorithms: ["HS256"],
+          audience: "executor-oidc-nonce",
+          requiredClaims: ["exp", "iat"],
+        });
+        if (typeof payload.nonce === "string") nonce = payload.nonce;
+      } catch {
+        /* Invalid nonce fails closed in the profile verification hook. */
+      }
+    }
+    if (!nonce) return Response.json({ error: "oidc_nonce_invalid" }, { status: 401 });
+  }
+  const response = await contexts.run({ nonce }, run);
+  const headers = new Headers(response.headers);
+  if (signingIn) {
+    const cookie = await new SignJWT({ nonce })
+      .setProtectedHeader({ alg: "HS256" })
+      .setAudience("executor-oidc-nonce")
+      .setIssuedAt()
+      .setExpirationTime("10m")
+      .sign(key);
+    headers.append(
+      "set-cookie",
+      `${NONCE_COOKIE}=${cookie}; Path=/; Secure; HttpOnly; SameSite=Lax; Max-Age=600`,
+    );
+  } else
+    headers.append(
+      "set-cookie",
+      `${NONCE_COOKIE}=; Path=/; Secure; HttpOnly; SameSite=Lax; Max-Age=0`,
+    );
+  return new Response(response.body, { status: response.status, headers });
+}
