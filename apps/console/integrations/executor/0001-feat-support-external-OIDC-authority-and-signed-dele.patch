diff --git a/apps/host-selfhost/scripts/check-sso-ui.ts b/apps/host-selfhost/scripts/check-sso-ui.ts
new file mode 100644
index 0000000..df44992
--- /dev/null
+++ b/apps/host-selfhost/scripts/check-sso-ui.ts
@@ -0,0 +1,56 @@
+// Render-only regression. It deliberately does not claim IdP/TLS acceptance.
+// Attach to a local instance configured for SSO-only; no credentials required.
+import { chromium } from "playwright";
+import { mkdir } from "node:fs/promises";
+import { join } from "node:path";
+
+const target = process.env.SSO_UI_TEST_URL ?? "http://127.0.0.1:14789";
+const output = process.env.SSO_UI_TEST_OUTPUT ?? "/tmp/executor-sso-ui-evidence";
+await mkdir(output, { recursive: true });
+const browser = await chromium.launch({ headless: true, channel: "chrome" });
+for (const width of [1280, 390, 320]) {
+  const context = await browser.newContext({ viewport: { width, height: 800 } });
+  await context.tracing.start({ screenshots: true, snapshots: true });
+  const page = await context.newPage();
+  const errors: string[] = [];
+  page.on("pageerror", (error) => errors.push(error.message));
+  await page.goto(`${target}/login`);
+  await page.getByRole("button", { name: "Continue with Organization" }).waitFor();
+  const passwordCount = await page.locator('input[type="password"]').count();
+  const inviteCount = await page.getByText("Have an invite code? Join", { exact: true }).count();
+  const overflow = await page.evaluate(
+    () => document.documentElement.scrollWidth > window.innerWidth,
+  );
+  if (passwordCount || inviteCount || overflow || errors.length) {
+    throw new Error(
+      `SSO render failed at ${width}: ${JSON.stringify({ passwordCount, inviteCount, overflow, errors })}`,
+    );
+  }
+  await page.screenshot({ path: join(output, `sso-${width}.png`), fullPage: true });
+  await context.tracing.stop({ path: join(output, `sso-${width}-trace.zip`) });
+  await context.close();
+}
+const context = await browser.newContext({ viewport: { width: 390, height: 800 } });
+const page = await context.newPage();
+await page.route("**/api/auth-config", (route) =>
+  route.fulfill({ status: 503, contentType: "application/json", body: "{}" }),
+);
+await page.goto(`${target}/login`);
+await page.getByRole("button", { name: "Retry", exact: true }).waitFor();
+if (await page.locator('input[type="password"]').count())
+  throw new Error("Failed config exposed password fallback");
+await page.screenshot({ path: join(output, "sso-error-390.png"), fullPage: true });
+await page.unroute("**/api/auth-config");
+await page.getByRole("button", { name: "Retry", exact: true }).click();
+await page.getByRole("button", { name: "Continue with Organization" }).waitFor();
+await context.close();
+await browser.close();
+console.log(
+  JSON.stringify({
+    status: "PASS",
+    widths: [1280, 390, 320],
+    failureAndRetry: true,
+    output,
+    scope: "render only; actual SSO/TLS must be tested separately",
+  }),
+);
