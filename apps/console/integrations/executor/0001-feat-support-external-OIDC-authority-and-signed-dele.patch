+++ b/apps/host-selfhost/src/delegation/protocol.test.ts
@@ -0,0 +1,159 @@
+import { generateKeyPairSync, randomUUID } from "node:crypto";
+import { afterEach, beforeEach, describe, expect, it, vi } from "@effect/vitest";
+import { importPKCS8, importSPKI, jwtVerify, SignJWT } from "jose";
+import { delegatedOperationHandler } from "./handler";
+import { hash, signCallback, stableJson, verifyDelegation } from "./protocol";
+
+const keypair = () =>
+  generateKeyPairSync("ec", {
+    namedCurve: "P-256",
+    privateKeyEncoding: { type: "pkcs8", format: "pem" },
+    publicKeyEncoding: { type: "spki", format: "pem" },
+  });
+const authorityKey = keypair();
+const executorKey = keypair();
+const issuer = "https://authority.test";
+const audience = "https://executor.test";
+const operation = {
+  host: "page.test",
+  id: "ravi.bases.views.rows.create",
+  input: {
+    viewId: randomUUID(),
+    values: { title: "synthetic" },
+    idempotencyKey: "test-operation-1",
+  },
+  origin: "https://page.test",
+  pagesSession: "synthetic-session",
+  requestId: "request-one",
+};
+const actorId = randomUUID();
+const makeToken = async (changes: Record<string, unknown> = {}, wrongKey = false) => {
+  const now = Math.floor(Date.now() / 1000);
+  return new SignJWT({
+    kind: "page-operation",
+    actor: "human_viewer",
+    actorId,
+    sub: actorId,
+    organizationId: randomUUID(),
+    projectId: randomUUID(),
+    siteId: randomUUID(),
+    releaseId: randomUUID(),
+    bodyHash: hash(stableJson(operation)),
+    sessionHash: hash(operation.pagesSession),
+    iss: issuer,
+    aud: audience,
+    iat: now,
+    exp: now + 60,
+    jti: randomUUID(),
+    ...changes,
+  })
+    .setProtectedHeader({ alg: "ES256", typ: "executor-delegation+jwt" })
+    .sign(await importPKCS8((wrongKey ? executorKey : authorityKey).privateKey, "ES256"));
+};
+beforeEach(() => {
+  vi.stubEnv("EXECUTOR_DELEGATION_ISSUER", issuer);
+  vi.stubEnv("EXECUTOR_WEB_BASE_URL", audience);
+  vi.stubEnv("EXECUTOR_DELEGATION_PUBLIC_KEY_PEM", authorityKey.publicKey);
+  vi.stubEnv("EXECUTOR_CALLBACK_PRIVATE_KEY_PEM", executorKey.privateKey);
+});
+afterEach(() => {
+  vi.unstubAllEnvs();
+  vi.unstubAllGlobals();
+});
+
+describe("signed delegation boundary", () => {
+  it("verifies signed exact payload", async () => {
+    expect((await verifyDelegation(await makeToken(), operation)).actorId).toBe(actorId);
+  });
+  it("refuses changed site, actor, audience, input, credentials and expired proof", async () => {
+    const now = Math.floor(Date.now() / 1000);
+    for (const changes of [
+      { aud: issuer },
+      { iss: audience },
+      { actor: "admin" },
+      { sub: randomUUID() },
+      { iat: now - 120, exp: now - 60 },
+      { exp: now + 600 },
+    ]) {
+      await expect(verifyDelegation(await makeToken(changes), operation)).rejects.toThrow();
+    }
+    await expect(verifyDelegation(await makeToken({}, true), operation)).rejects.toThrow();
+    const token = await makeToken();
+    for (const changes of [
+      { host: "evil.test" },
+      { input: { confirmed: true } },
+      { pagesSession: "different" },
+      { origin: "https://evil.test" },
+    ]) {
+      await expect(verifyDelegation(token, { ...operation, ...changes })).rejects.toThrow();
+    }
+  });
+  it("signs independent callback proof bound to delegation", async () => {
+    const token = await signCallback("operation-callback", { delegationHash: hash("test") });
+    const { payload } = await jwtVerify(token, await importSPKI(executorKey.publicKey, "ES256"), {
+      issuer: audience,
+      audience: issuer,
+      algorithms: ["ES256"],
+    });
+    expect(payload.delegationHash).toBe(hash("test"));
+    expect(payload.exp! - payload.iat!).toBe(60);
+  });
+});
+
+describe("real QuickJS bridge (authority transport mocked, not staging acceptance)", () => {
+  const request = (body: unknown) =>
+    new Request(`${audience}/api/delegated-operations`, {
+      method: "POST",
+      body: JSON.stringify(body),
+    });
+  it("runs the fixed host tool without exposing session to arbitrary sandbox code", async () => {
+    const delegation = await makeToken();
+    let calls = 0;
+    vi.stubGlobal("fetch", async (url: string, init: RequestInit) => {
+      calls++;
+      expect(url).toBe(`${issuer}/api/executor/operations/execute`);
+      expect(init.redirect).toBe("error");
+      expect(await new Response(init.body).json()).toEqual({ delegation, operation });
+      const proof = new Headers(init.headers).get("authorization")!.slice(7);
+      const verified = await jwtVerify(proof, await importSPKI(executorKey.publicKey, "ES256"), {
+        issuer: audience,
+        audience: issuer,
+      });
+      expect(verified.payload.delegationHash).toBe(hash(delegation));
+      return Response.json({ output: { rowId: "synthetic-row", version: 1 } });
+    });
+    const response = await delegatedOperationHandler(request({ delegation, operation }));
+    expect(response.status).toBe(200);
+    expect(await response.json()).toEqual({ output: { rowId: "synthetic-row", version: 1 } });
+    expect(calls).toBe(1);
+  });
+  it("refuses untrusted approval/code fields and unsigned direct calls before invocation", async () => {
+    const fetch = vi.fn();
+    vi.stubGlobal("fetch", fetch);
+    const delegation = await makeToken();
+    for (const body of [
+      { delegation: "forged", operation },
+      { delegation, operation, code: "return 1" },
+      { delegation, operation: { ...operation, confirmed: true } },
+    ]) {
+      expect((await delegatedOperationHandler(request(body))).status).toBe(401);
+    }
+    expect(fetch).not.toHaveBeenCalled();
+  });
+  it("preserves authorization denials and returns explicit recoverable error on transport loss", async () => {
+    const delegation = await makeToken();
+    vi.stubGlobal("fetch", async () =>
+      Response.json({ error: "approval_forbidden" }, { status: 403 }),
+    );
+    const denial = await delegatedOperationHandler(request({ delegation, operation }));
+    expect(denial.status).toBe(403);
+    expect(await denial.json()).toEqual({ error: "approval_forbidden" });
+    vi.stubGlobal("fetch", async () => {
+      // oxlint-disable-next-line executor/no-try-catch-or-throw, executor/no-error-constructor -- boundary: reproduce the native fetch rejection contract in a transport unit test
+      throw new Error("connection lost");
+    });
+    const interrupted = await delegatedOperationHandler(request({ delegation, operation }));
+    expect(interrupted.status).toBe(503);
+    expect(await interrupted.json()).toEqual({ error: "executor_unavailable" });
+  });
+});
