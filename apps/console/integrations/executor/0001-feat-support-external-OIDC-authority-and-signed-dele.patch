+import { Data, Effect } from "effect";
+import { makeQuickJsExecutor } from "@executor-js/runtime-quickjs";
+import {
+  hash,
+  isDelegatedOperation,
+  origin,
+  signCallback,
+  verifyDelegation,
+  type DelegatedOperation,
+} from "./protocol";
+
+const BODY_LIMIT = 1024 * 1024;
+class DelegationTransportError extends Data.TaggedError("DelegationTransportError")<{}> {}
+async function boundedBody(request: Request): Promise<unknown> {
+  const reader = request.body?.getReader();
+  // oxlint-disable-next-line executor/no-try-catch-or-throw, executor/no-error-constructor -- boundary: bounded HTTP parser rejects missing request body
+  if (!reader) throw new Error("Missing body");
+  const chunks: Uint8Array[] = [];
+  let length = 0;
+  while (true) {
+    const { done, value } = await reader.read();
+    if (done) break;
+    length += value.byteLength;
+    if (length > BODY_LIMIT) {
+      await reader.cancel();
+      // oxlint-disable-next-line executor/no-try-catch-or-throw, executor/no-error-constructor -- boundary: stop reading before parsing an oversized HTTP request
+      throw new Error("Body too large");
+    }
+    chunks.push(value);
+  }
+  // oxlint-disable-next-line executor/no-json-parse -- boundary: bounded JSON input is structurally validated and cryptographically verified by the handler
+  return JSON.parse(Buffer.concat(chunks).toString("utf8"));
+}
+
+/** A deliberately narrow host-tool bridge. Neither sandbox nor browser chooses
+ * code, URL, headers, approval policy, identity or credentials. The authority
+ * revalidates all resource authorization at the callback, including retries. */
+export async function delegatedOperationHandler(request: Request): Promise<Response> {
+  if (!process.env.EXECUTOR_DELEGATION_ISSUER)
+    return Response.json({ error: "not_found" }, { status: 404 });
+  if (request.method !== "POST")
+    return Response.json({ error: "method_not_allowed" }, { status: 405 });
+  let body: { delegation: string; operation: DelegatedOperation };
+  // oxlint-disable-next-line executor/no-try-catch-or-throw -- boundary: map parsing and jose verification exceptions to a non-disclosing HTTP denial
+  try {
+    const parsed = await boundedBody(request);
+    if (!parsed || typeof parsed !== "object")
+      return Response.json({ error: "executor_unauthorized" }, { status: 401 });
+    body = parsed as typeof body;
+    if (
+      Object.keys(body).some((key) => key !== "delegation" && key !== "operation") ||
+      typeof body.delegation !== "string" ||
+      body.delegation.length > 16_384 ||
+      !isDelegatedOperation(body.operation)
+    )
+      return Response.json({ error: "executor_unauthorized" }, { status: 401 });
+    await verifyDelegation(body.delegation, body.operation);
+  } catch {
+    return Response.json({ error: "executor_unauthorized" }, { status: 401 });
+  }
+
+  // oxlint-disable-next-line executor/no-try-catch-or-throw -- boundary: the public Fetch adapter maps failed Effect execution to a safe retryable HTTP response
+  try {
+    const proof = await signCallback("operation-callback", {
+      delegationHash: hash(body.delegation),
+    });
+    // Invoke the actual upstream QuickJS executor. The sandbox has exactly one
+    // zero-argument host tool and never receives the sensitive request envelope.
+    const sandbox = makeQuickJsExecutor({ timeoutMs: 15_000 });
+    const result = await Effect.runPromise(
+      sandbox.execute("return await tools.delegation.execute({});", {
+        invoke: ({ path, args }) =>
+          Effect.tryPromise({
+            try: async () => {
+              if (path !== "delegation.execute" || JSON.stringify(args) !== "{}")
+                return { status: 403, body: { error: "executor_action_forbidden" } };
+              const response = await fetch(
+                `${origin("EXECUTOR_DELEGATION_ISSUER")}/api/executor/operations/execute`,
+                {
+                  method: "POST",
+                  headers: { "content-type": "application/json", authorization: `Bearer ${proof}` },
+                  body: JSON.stringify(body),
+                  redirect: "error",
+                  signal: AbortSignal.timeout(12_000),
+                },
+              );
+              return { status: response.status, body: await response.json() };
+            },
+            catch: () => new DelegationTransportError(),
+          }),
+      }),
+    );
+    if (result.error || !result.result || typeof result.result !== "object")
+      return Response.json({ error: "executor_unavailable" }, { status: 503 });
+    const output = result.result as { status: number; body: unknown };
+    if (!Number.isInteger(output.status) || output.status < 200 || output.status > 599)
+      return Response.json({ error: "executor_unavailable" }, { status: 503 });
+    return Response.json(output.body, {
+      status: output.status,
+      headers: { "cache-control": "no-store" },
+    });
+  } catch {
+    return Response.json({ error: "executor_unavailable" }, { status: 503 });
+  }
+}
