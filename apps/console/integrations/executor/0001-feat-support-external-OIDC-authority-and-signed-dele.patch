diff --git a/apps/host-selfhost/src/auth/authority.ts b/apps/host-selfhost/src/auth/authority.ts
new file mode 100644
index 0000000..a12c20a
--- /dev/null
+++ b/apps/host-selfhost/src/auth/authority.ts
@@ -0,0 +1,55 @@
+import type { Auth } from "./better-auth";
+import { hash, origin, setting, signCallback, stableJson } from "../delegation/protocol";
+
+export interface AuthorityIdentity {
+  userId: string;
+  organizationId: string;
+  email: string;
+  name: string | null;
+  role: string;
+}
+export const authorityEnabled = (): boolean =>
+  Boolean(process.env.EXECUTOR_IDENTITY_AUTHORITY_ORIGIN);
+
+/** Resolve the authenticated account by its stored provider subject, never by
+ * email or browser role claims. No cache: revocation applies to the next API
+ * request. A missing authority/link/membership fails closed. */
+export async function resolveAuthorityIdentity(
+  auth: Auth,
+  userId: string,
+): Promise<AuthorityIdentity | null> {
+  if (!authorityEnabled()) return null;
+  const authority = origin("EXECUTOR_IDENTITY_AUTHORITY_ORIGIN");
+  if (authority !== origin("EXECUTOR_DELEGATION_ISSUER")) return null;
+  const ctx = await auth.$context;
+  const user = await ctx.internalAdapter.findUserById(userId);
+  if (!user?.emailVerified) return null;
+  const account = await ctx.adapter.findOne<{ accountId: string }>({
+    model: "account",
+    where: [
+      { field: "userId", value: userId },
+      { field: "providerId", value: setting("EXECUTOR_SSO_PROVIDER_ID") },
+    ],
+  });
+  if (!account || typeof account.accountId !== "string") return null;
+  const body = { issuer: setting("EXECUTOR_IDENTITY_ISSUER"), subject: account.accountId };
+  const proof = await signCallback("identity-resolve", { bodyHash: hash(stableJson(body)) });
+  const response = await fetch(`${authority}/api/executor/identity/resolve`, {
+    method: "POST",
+    headers: { "content-type": "application/json", authorization: `Bearer ${proof}` },
+    body: JSON.stringify(body),
+    redirect: "error",
+    signal: AbortSignal.timeout(5_000),
+  });
+  if (!response.ok) return null;
+  const identity = (await response.json()) as Partial<AuthorityIdentity>;
+  if (
+    typeof identity.userId !== "string" ||
+    typeof identity.email !== "string" ||
+    typeof identity.role !== "string" ||
+    (identity.name !== null && typeof identity.name !== "string") ||
+    identity.organizationId !== setting("EXECUTOR_AUTHORITY_ORGANIZATION_ID")
+  )
+    return null;
+  return identity as AuthorityIdentity;
+}
