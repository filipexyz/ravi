new file mode 100644
index 0000000..2363ae7
--- /dev/null
+++ b/apps/host-selfhost/src/delegation/protocol.ts
@@ -0,0 +1,110 @@
+import { createHash, randomUUID } from "node:crypto";
+import { readFileSync } from "node:fs";
+import { importPKCS8, importSPKI, jwtVerify, SignJWT } from "jose";
+
+export const hash = (value: string): string => createHash("sha256").update(value).digest("hex");
+export const stableJson = (value: unknown): string => {
+  if (value === null || value === undefined) return "null";
+  if (Array.isArray(value)) return `[${value.map(stableJson).join(",")}]`;
+  if (typeof value !== "object") return JSON.stringify(value);
+  return `{${Object.entries(value)
+    .filter(([, v]) => v !== undefined)
+    .sort(([a], [b]) => (a < b ? -1 : a > b ? 1 : 0))
+    .map(([k, v]) => `${JSON.stringify(k)}:${stableJson(v)}`)
+    .join(",")}}`;
+};
+export const setting = (name: string): string => {
+  const file = process.env[`${name}_FILE`];
+  const value = file ? readFileSync(file, "utf8").trim() : process.env[name]?.trim();
+  // oxlint-disable-next-line executor/no-try-catch-or-throw, executor/no-error-constructor -- boundary: synchronous configuration loader fails closed
+  if (!value) throw new Error("Delegation configuration unavailable");
+  return value;
+};
+export const origin = (name: string): string => {
+  const value = setting(name);
+  const url = new URL(value);
+  if (
+    url.protocol !== "https:" ||
+    value !== url.origin ||
+    url.username ||
+    url.password ||
+    url.hostname.includes("*")
+  ) {
+    // oxlint-disable-next-line executor/no-try-catch-or-throw, executor/no-error-constructor -- boundary: reject invalid operator origin before signing
+    throw new Error("Delegation requires pinned HTTPS origins");
+  }
+  return value;
+};
+export interface DelegatedOperation {
+  host: string;
+  id: string;
+  input: unknown;
+  origin: string | null;
+  pagesSession: string;
+  requestId: string;
+}
+export function isDelegatedOperation(value: unknown): value is DelegatedOperation {
+  if (!value || typeof value !== "object" || Array.isArray(value)) return false;
+  const record = value as Record<string, unknown>;
+  const keys = ["host", "id", "input", "origin", "pagesSession", "requestId"];
+  if (Object.keys(record).some((key) => !keys.includes(key)) || !Object.hasOwn(record, "input"))
+    return false;
+  for (const [key, max] of [
+    ["host", 253],
+    ["id", 128],
+    ["pagesSession", 8192],
+    ["requestId", 128],
+  ] as const) {
+    if (typeof record[key] !== "string" || record[key].length < 1 || record[key].length > max)
+      return false;
+  }
+  return (
+    record.origin === null || (typeof record.origin === "string" && record.origin.length <= 1024)
+  );
+}
+export async function verifyDelegation(token: string, operation: DelegatedOperation) {
+  // oxlint-disable-next-line executor/no-try-catch-or-throw, executor/no-error-constructor -- boundary: match jose's rejecting Promise contract on invalid HTTP input
+  if (!isDelegatedOperation(operation)) throw new Error("Invalid operation");
+  const { payload, protectedHeader } = await jwtVerify(
+    token,
+    await importSPKI(setting("EXECUTOR_DELEGATION_PUBLIC_KEY_PEM"), "ES256"),
+    {
+      algorithms: ["ES256"],
+      issuer: origin("EXECUTOR_DELEGATION_ISSUER"),
+      audience: origin("EXECUTOR_WEB_BASE_URL"),
+      requiredClaims: ["iat", "exp", "jti", "sub"],
+      maxTokenAge: "60s",
+    },
+  );
+  if (
+    protectedHeader.typ !== "executor-delegation+jwt" ||
+    payload.kind !== "page-operation" ||
+    payload.actor !== "human_viewer" ||
+    payload.sub !== payload.actorId ||
+    typeof payload.actorId !== "string" ||
+    typeof payload.organizationId !== "string" ||
+    typeof payload.siteId !== "string" ||
+    typeof payload.projectId !== "string" ||
+    typeof payload.releaseId !== "string" ||
+    !Number.isInteger(payload.iat) ||
+    payload.exp! - payload.iat! !== 60 ||
+    payload.iat! > Math.floor(Date.now() / 1000) ||
+    payload.bodyHash !== hash(stableJson(operation)) ||
+    payload.sessionHash !== hash(operation.pagesSession)
+  ) {
+    // oxlint-disable-next-line executor/no-try-catch-or-throw, executor/no-error-constructor -- boundary: jose verification rejects invalid authenticated claims
+    throw new Error("Invalid delegation");
+  }
+  return payload;
+}
+export async function signCallback(kind: string, claims: Record<string, unknown>): Promise<string> {
+  const now = Math.floor(Date.now() / 1000);
+  return new SignJWT({ ...claims, kind })
+    .setProtectedHeader({ alg: "ES256", typ: "executor-callback+jwt" })
+    .setIssuer(origin("EXECUTOR_WEB_BASE_URL"))
+    .setAudience(origin("EXECUTOR_DELEGATION_ISSUER"))
+    .setJti(randomUUID())
+    .setIssuedAt(now)
+    .setExpirationTime(now + 60)
+    .sign(await importPKCS8(setting("EXECUTOR_CALLBACK_PRIVATE_KEY_PEM"), "ES256"));
+}
