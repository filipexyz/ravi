{
  "name": "ravi-console",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "deploy:build": "bun scripts/migrate-with-lock.ts && bun run build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:check": "bun scripts/db-check.ts",
    "bug:harness": "bun scripts/bug-harness.ts",
    "bug:triage-worker": "bun scripts/bug-triage-worker.ts",
    "event-plane:controller": "bun scripts/event-plane-controller.ts",
    "event-plane:controller:test": "bun test scripts/event-plane-controller.test.ts",
    "runtime-hostd": "bun scripts/runtime-hostd.ts",
    "pages:runtime:build": "bun scripts/build-pages-runtime.ts",
    "pages:worker:dev": "wrangler dev --config wrangler.pages.toml",
    "pages:worker:deploy": "wrangler deploy --config wrangler.pages.toml",
    "pages:worker:dry-run": "wrangler deploy --config wrangler.pages.toml --dry-run",
    "pages:worker:types": "wrangler types --config wrangler.pages.toml workers/pages/worker-configuration.d.ts",
    "channels:worker:dev": "wrangler dev --config wrangler.channels.toml",
    "channels:worker:deploy": "wrangler deploy --config wrangler.channels.toml",
    "channels:worker:dry-run": "wrangler deploy --config wrangler.channels.toml --dry-run",
    "connectors:worker:dev": "wrangler dev --config wrangler.connectors.toml",
    "connectors:worker:deploy": "wrangler deploy --config wrangler.connectors.toml",
    "connectors:worker:dry-run": "wrangler deploy --config wrangler.connectors.toml --dry-run",
    "fleet:transport": "bun run fleet:build && node .fleet-dist/transport.mjs",
    "fleet:build": "bun scripts/build-fleet-transport.ts",
    "fleet:init": "bun scripts/fleet-init.ts",
    "fleet:install": "bun scripts/prepare-installation.ts"
  },
  "dependencies": {
    "@ai-sdk/deepseek": "3.0.67",
    "@anthropic-ai/sdk": "0.135.0",
    "@node-rs/argon2": "^2.0.2",
    "@peculiar/x509": "^3.1.0",
    "@ravi/console-sdk": "workspace:*",
    "@ravi/operation-contracts": "workspace:*",
    "@sentry/cloudflare": "^10.55.0",
    "@sentry/nextjs": "^10.52.0",
    "@tanstack/react-form": "^1.30.0",
    "@tanstack/react-query": "^5.100.9",
    "@tanstack/react-query-devtools": "^5.100.9",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.13.24",
    "@tanstack/store": "^0.11.0",
    "@workflow/world-postgres": "5.0.5",
    "@workos-inc/authkit-nextjs": "^4.0.1",
    "acorn": "^8.19.0",
    "ai": "7.0.143",
    "aws4fetch": "^1.0.20",
    "axe-core": "^4.14.0",
    "casbin": "5.51.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "diff": "8.0.2",
    "drizzle-orm": "^0.45.2",
    "htmlparser2": "^12.0.0",
    "ipaddr.js": "^2.5.0",
    "jose": "^6.2.3",
    "lucide-react": "^1.14.0",
    "next": "^16.2.6",
    "openid-client": "^6.8.8",
    "playwright": "^1.64.1",
    "postgres": "^3.4.9",
    "qrcode": "^1.5.4",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "reflect-metadata": "^0.2.2",
    "ssh2": "^1.17.0",
    "tailwind-merge": "^3.5.0",
    "tldts": "^7.4.10",
    "workflow": "5.2.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "@types/bun": "latest",
    "@types/node": "^25.6.2",
    "@types/oidc-provider": "^9.12.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/ssh2": "^1.15.6",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "^16.2.6",
    "happy-dom": "^21.0.3",
    "oidc-provider": "^9.13.0",
    "postcss": "^8.5.14",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "wrangler": "^4.90.0"
  },
  "private": true,
  "type": "module",
  "license": "MIT"
}
