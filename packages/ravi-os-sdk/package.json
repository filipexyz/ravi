{
  "name": "@ravi-os/sdk",
  "version": "0.260725.1",
  "description": "Type-safe TypeScript SDK for the Ravi gateway, generated from the live registry.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./inherit": {
      "types": "./dist/inherit.d.ts",
      "default": "./dist/inherit.js"
    },
    "./schemas": {
      "types": "./dist/schemas.d.ts",
      "default": "./dist/schemas.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "default": "./dist/types.js"
    },
    "./errors": {
      "types": "./dist/errors.d.ts",
      "default": "./dist/errors.js"
    },
    "./streaming": {
      "types": "./dist/streaming.d.ts",
      "default": "./dist/streaming.js"
    },
    "./channel-backend": {
      "types": "./dist/channel-backend.d.ts",
      "default": "./dist/channel-backend.js"
    },
    "./channel-runtime-events": {
      "types": "./dist/channel-runtime-events.d.ts",
      "default": "./dist/channel-runtime-events.js"
    },
    "./native-channel-driver": {
      "types": "./dist/native-channel-driver.d.ts",
      "default": "./dist/native-channel-driver.js"
    },
    "./remote-login-provider": {
      "types": "./dist/remote-login-provider.d.ts",
      "default": "./dist/remote-login-provider.js"
    },
    "./local-agent-reconciliation": {
      "types": "./dist/local-agent-reconciliation.d.ts",
      "default": "./dist/local-agent-reconciliation.js"
    },
    "./transport/http": {
      "types": "./dist/transport/http.d.ts",
      "default": "./dist/transport/http.js"
    }
  },
  "files": [
    "dist/",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "peerDependencies": {
    "zod": "^4.0.0"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
