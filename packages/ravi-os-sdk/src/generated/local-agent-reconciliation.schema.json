        },
        "instructions": {
          "type": "string"
        },
        "protocol": {
          "const": "ravi.agent.local-reconciliation",
          "type": "string"
        },
        "requestedCapabilities": {
          "default": [],
          "items": {
            "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
            "type": "string"
          },
          "maxItems": 128,
          "type": "array"
        },
        "requestId": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._~-]*$",
          "type": "string"
        },
        "revision": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        "runtime": {
          "properties": {
            "model": {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._~-]*$",
              "type": "string"
            },
            "modelPreset": {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._~-]*$",
              "type": "string"
            },
            "provider": {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._~-]*$",
              "type": "string"
            }
          },
          "type": "object"
        },
        "schemaVersion": {
          "const": 1,
          "type": "number"
        },
        "sourceId": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._~-]*$",
          "type": "string"
        },
        "templateId": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._~-]*$",
          "type": "string"
        }
      },
      "required": [
        "protocol",
        "schemaVersion",
        "requestId",
        "idempotencyKey",
        "sourceId",
        "agentKey",
        "templateId",
        "revision"
      ],
      "type": "object"
    },
    "LocalAgentReconciliationResult": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "agentId": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._~-]*$",
          "type": "string"
        },
        "appliedRevision": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        "disposition": {
          "enum": [
            "created",
            "updated",
            "unchanged",
            "blocked"
