          "type": "string"
        },
        "error": {
          "properties": {
            "category": {
              "enum": [
                "validation",
                "authentication",
                "authorization",
                "capacity",
                "availability",
                "internal"
              ],
              "type": "string"
            },
            "code": {
              "enum": [
                "INVALID_REQUEST",
                "IDEMPOTENCY_CONFLICT",
                "UNAUTHENTICATED",
                "PERMISSION_DENIED",
                "LOCAL_PERMISSION_DENIED",
                "NOT_FOUND",
                "RATE_LIMITED",
                "OVERLOADED",
                "UNAVAILABLE",
                "INTERNAL"
              ],
              "type": "string"
            },
            "correlationId": {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._~-]*$",
              "type": "string"
            },
            "retryable": {
              "type": "boolean"
            },
            "retryAfterMs": {
              "exclusiveMinimum": 0,
              "maximum": 86400000,
              "type": "integer"
