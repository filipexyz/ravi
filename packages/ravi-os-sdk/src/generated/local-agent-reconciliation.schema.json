          "default": [],
          "items": {
            "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
            "type": "string"
          },
          "maxItems": 128,
          "type": "array"
        },
        "observedAt": {
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
          "type": "string"
        },
        "protocol": {
          "const": "ravi.agent.local-reconciliation",
          "type": "string"
        },
        "requestId": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._~-]*$",
          "type": "string"
        },
        "schemaVersion": {
          "const": 1,
          "type": "number"
        },
        "state": {
          "enum": [
            "ready",
            "blocked"
          ],
          "type": "string"
        }
      },
      "required": [
        "protocol",
        "schemaVersion",
        "requestId",
        "disposition",
        "state",
        "observedAt"
      ],
      "type": "object"
    },
    "LocalAgentRuntimePreference": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "model": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._~-]*$",
          "type": "string"
        },
        "modelPreset": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._~-]*$",
          "type": "string"
        },
        "provider": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._~-]*$",
          "type": "string"
        }
      },
      "type": "object"
    }
