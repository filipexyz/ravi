{
  "schema": "ravi.app/v1",
  "id": "merchant",
  "name": "Google Merchant",
  "version": "0.1.0",
  "description": "Opera contas, produtos, relatórios, fontes e promoções pelo Google Merchant API nativo.",
  "interfaces": {
    "cli": {
      "command": "ravi merchant",
      "json": true,
      "health": "ravi apps check merchant --json"
    },
    "sdk": {
      "namespace": "merchant"
    },
    "ui": {
      "routes": [
        {
          "id": "main",
          "path": "/apps/merchant",
          "label": "Merchant",
          "icon": "shopping-bag",
          "view": "overview"
        }
      ],
      "views": [
        {
          "id": "overview",
          "type": "dashboard",
          "title": "Google Merchant",
          "density": "compact",
          "query": {
            "operation": "merchant.products"
          },
          "actions": [
            {
              "id": "products",
              "label": "Produtos",
              "icon": "package",
              "operation": "merchant.products",
              "placement": "toolbar",
              "permission": "merchant:read"
            },
            {
              "id": "issues",
              "label": "Issues",
              "icon": "triangle-alert",
              "operation": "merchant.account-issues",
              "placement": "toolbar",
              "permission": "merchant:read"
            },
            {
              "id": "data-sources",
              "label": "Fontes",
              "icon": "database",
              "operation": "merchant.data-sources",
              "placement": "toolbar",
              "permission": "merchant:read"
            }
          ]
        }
      ]
    }
  },
