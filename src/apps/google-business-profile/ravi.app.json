  "permissions": {
    "required": [
      "gbp:accounts:read",
      "gbp:locations:read",
      "gbp:reviews:read",
      "gbp:posts:read",
      "gbp:media:read",
      "gbp:performance:read",
      "gbp:categories:read",
      "gbp:attributes:read",
      "gbp:verifications:read",
      "gbp:admins:read"
    ],
    "optional": [],
    "mutating": [
      "gbp:locations:write",
      "gbp:locations:delete",
      "gbp:reviews:write",
      "gbp:reviews:delete",
      "gbp:posts:write",
      "gbp:posts:delete",
      "gbp:media:write",
      "gbp:media:delete",
      "gbp:verifications:write",
      "gbp:admins:write",
      "gbp:admins:delete"
    ]
  },
  "storage": { "sqlite": [], "files": [] },
  "artifacts": [],
  "events": { "emits": [], "consumes": [] },
  "skills": [],
  "health": {
    "checks": [{ "type": "builtin", "handler": "apps.manifest.check" }]
  },
  "versioning": { "compatibility": "semver", "migrations": [] }
}
