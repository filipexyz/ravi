# Required: Anthropic API key for Claude access
ANTHROPIC_API_KEY=your-api-key-here

# Optional: Model to use (default: claude-sonnet-4-20250514)
# RAVI_MODEL=claude-sonnet-4-20250514

# Optional: Log level (default: info)
# Options: debug, info, warn, error
# RAVI_LOG_LEVEL=info

# Optional: Gemini API key for video analysis
# GEMINI_API_KEY=your-gemini-key-here

# Optional: SDK gateway CORS (closed by default; chrome-extension:// is always allowed)
# Exact origins, comma-separated. The gateway echoes Origin only if listed.
# RAVI_CORS_ORIGINS=http://127.0.0.1:8088
# Dev-only: allow http://localhost:<port> and http://127.0.0.1:<port>
# RAVI_CORS_LOCALHOST=1

