{
  "$schema": "https://mintlify.com/docs.json",
  "name": "Ravi",
  "description": "Run AI agents on your own machine and reach them from Slack, WhatsApp and the web.",
  "theme": "mint",
  "colors": {
    "primary": "#06B6D4",
    "dark": "#0891B2",
    "light": "#22D3EE"
  },
  "font": {
    "body": "Fragment Mono",
    "heading": "DM Sans"
  },
  "logo": {
    "light": "/logo-light.svg",
    "dark": "/logo-dark.svg"
  },
  "favicon": "/favicon.svg",
  "cname": "docs.ravi.bot",
  "navbar": {
    "links": [
      {
        "label": "GitHub",
        "href": "https://github.com/filipexyz/ravi"
      }
    ]
  },
  "icons": {
    "style": "lucide",
    "library": "lucide"
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Get Started",
        "groups": [
          {
            "group": "Start here",
            "pages": [
              "index",
              "start/install",
              "start/owner"
            ]
          },
          {
            "group": "Connect a channel",
            "pages": [
              "channels/slack",
              "channels/whatsapp"
            ]
          },
          {
            "group": "Console and Pages",
            "pages": [
              "console/login",
              "console/pages",
              "console/bases"
            ]
          },
          {
            "group": "Build on Ravi",
            "pages": [
              "guides/sdk"
            ]
          }
        ]
      },
      {
        "tab": "Guides",
        "groups": [
          {
            "group": "Conversations",
            "pages": [
              "guides/sessions",
              "guides/contacts",
              "guides/routing"
            ]
          },
          {
            "group": "Automation",
            "pages": [
              "guides/cron-jobs",
              "guides/triggers",
              "guides/heartbeat"
            ]
          },
          {
            "group": "Security",
            "pages": [
              "guides/permissions"
            ]
          },
          {
            "group": "Operations",
            "pages": [
              "guides/troubleshooting"
            ]
          }
        ]
      },
      {
        "tab": "Reference",
        "groups": [
          {
            "group": "CLI",
            "pages": [
              "cli/overview"
            ]
          },
          {
            "group": "System",
            "pages": [
              "architecture",
              "reference/configuration",
              "reference/nats-events"
            ]
          },
          {
            "group": "Tools",
            "pages": [
              "reference/media",
              "reference/artifacts",
              "reference/skills"
            ]
          }
        ]
      },
      {
        "tab": "API",
        "groups": [
          {
            "group": "API reference",
            "openapi": "openapi.json"
          }
        ]
      }
    ]
  },
  "redirects": [
    {
      "source": "/start/quickstart",
      "destination": "/start/install"
    },
    {
      "source": "/start/first-time-runbook",
      "destination": "/start/install"
    },
    {
      "source": "/start/configuration",
      "destination": "/reference/configuration"
    },
    {
      "source": "/features/overview",
      "destination": "/"
    },
    {
      "source": "/guides/instances",
      "destination": "/guides/routing"
    },
    {
      "source": "/guides/whatsapp-groups",
      "destination": "/guides/routing"
    },
    {
      "source": "/guides/nats-debugging",
      "destination": "/guides/troubleshooting"
    },
    {
      "source": "/guides/copilot",
      "destination": "/"
    },
    {
      "source": "/guides/development",
      "destination": "/architecture"
    },
    {
      "source": "/session-trace-v1",
      "destination": "/guides/troubleshooting"
    }
  ]
}
